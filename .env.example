# Copy to `.env.local` and adjust. Create React App only exposes variables that
# begin with REACT_APP_ to the bundle, and it substitutes them at BUILD time —
# changing one means rebuilding, not restarting.

# Origin of the Rails API. Leave empty for "same origin", which is correct when
# a reverse proxy (nginx in docker/, Netlify in production) forwards /api,
# /login, /logout and /signup to the backend. Set it only when the API is on a
# different host, and remember the API must then allow that origin via CORS and
# expose the Authorization header.
REACT_APP_API_URL=

# Dev server port. 3000 is the Rails API's default, so the client uses 8680.
PORT=8680

# Where `src/setupProxy.js` forwards API calls in development. Point it at a
# local Rails app (http://localhost:3000) or at `npm run mock-api`.
API_PROXY_TARGET=http://localhost:8681

# Port the bundled mock API listens on (`npm run mock-api`).
MOCK_API_PORT=8681
