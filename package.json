{
  "name": "event-management-fe",
  "version": "1.0.0",
  "private": true,
  "description": "React client for the event_management_app_BE Rails API.",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview --port 8680",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"*.{json,md,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"*.{json,md,mjs}\"",
    "mock-api": "node tools/mock-api.js",
    "screenshots": "playwright test --config e2e/playwright.config.js && node tools/optimise-screenshots.js docs/screenshots/*.png"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "^6.5.1",
    "@fortawesome/free-solid-svg-icons": "^6.5.1",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "axios": "^1.6.2",
    "bootstrap": "^5.3.2",
    "react": "^18.2.0",
    "react-bootstrap": "^2.9.1",
    "react-datepicker": "^4.24.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.12.0",
    "react-notifications": "^1.7.4",
    "react-router-dom": "^6.20.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.49.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^6.2.1",
    "axios-mock-adapter": "^1.22.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.2.5",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
