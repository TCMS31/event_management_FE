{
  "name": "event-management-fe",
  "version": "1.0.0",
  "private": true,
  "description": "React client for the event_management_app_BE Rails API.",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview --port 8680",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"*.{json,md,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"*.{json,md,mjs}\"",
    "mock-api": "node tools/mock-api.js",
    "screenshots": "playwright test --config e2e/playwright.config.js && node tools/optimise-screenshots.js docs/screenshots/*.png"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "bootstrap": "^5.3.8",
    "react": "^19.3.1",
    "react-bootstrap": "^2.10.10",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.2.1",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
