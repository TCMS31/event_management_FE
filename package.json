{
  "name": "event-management-fe",
  "version": "1.0.0",
  "private": true,
  "description": "React client for the event_management_app_BE Rails API.",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "^6.5.1",
    "@fortawesome/free-solid-svg-icons": "^6.5.1",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "axios": "^1.6.2",
    "bootstrap": "^5.3.2",
    "react": "^18.2.0",
    "react-bootstrap": "^2.9.1",
    "react-datepicker": "^4.24.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.12.0",
    "react-notifications": "^1.7.4",
    "react-router-dom": "^6.20.1",
    "styled-components": "^6.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "axios-mock-adapter": "^1.22.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "http-proxy-middleware": "^2.0.6",
    "prettier": "^3.2.5",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "PORT=${PORT:-8680} react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:ci": "CI=true react-scripts test --watchAll=false",
    "coverage": "CI=true react-scripts test --watchAll=false --coverage",
    "lint": "eslint \"src/**/*.js\" \"tools/**/*.js\" \"e2e/**/*.js\"",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"src/**/*.{js,css}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,css}\" \"*.{json,md}\"",
    "mock-api": "node tools/mock-api.js",
    "screenshots": "playwright test --config e2e/playwright.config.js && node tools/optimise-screenshots.js docs/screenshots/*.png"
  },
  "jest": {
    "moduleNameMapper": {
      "^axios$": "axios/dist/node/axios.cjs"
    },
    "coveragePathIgnorePatterns": [
      "src/index.js",
      "src/setupProxy.js",
      "src/testing/"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
